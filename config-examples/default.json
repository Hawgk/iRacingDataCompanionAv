{
  "font": "RobotoMono",
  "colorScheme": {
    "background": "#80141518",
    "surface": "#801E1F23",
    "text": "#FFE6E7EA",
    "textMuted": "#FF8B8E96",
    "playerHighlight": "#FFF2D49B",
    "lapAhead": "#FFF2A7A3",
    "lapBehind": "#FFA7C4F2",
    "fastestLap": "#FFC8B3F0",
    "pitRoad": "#FFA8DCC4",
    "warning": "#FFF2D49B",
    "iRatingGain": "#FF9ED6A5",
    "iRatingLoss": "#FFF0A3A0",
    "throttle": "#FF9ED6A5",
    "brake": "#FFF0A3A0"
  },
  "fontSizes": {
