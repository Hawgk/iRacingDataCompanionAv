      "IRating",
      "Laps",
      "FastestLap",
      "LastLap",
      "Gap"
    ]
  },
  "relatives": {
    "showColumnTitles": true,
    "columns": [
      "Position",
      "CarNumber",
      "Driver",
      "IRating",
      "Pit",
      "Interval",
      "LastLap"
    ]
  }
}