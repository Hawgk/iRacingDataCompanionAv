<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IRDCav.ViewModels"
        xmlns:table="using:IRDCav.Views.Table"
        x:Class="IRDCav.Views.ResultsWindow"
        x:DataType="vm:ResultsViewModel"
        Classes="overlay"
        Icon="/Assets/icon.ico"
        Title="iRDCav Results"
        SizeToContent="WidthAndHeight"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        IsVisible="{Binding IsVisible}">
	<LayoutTransformControl HorizontalAlignment="Left" VerticalAlignment="Top">
		<Border Classes="panel">
			<StackPanel>
				<Border Classes="header">
					<DockPanel>
						<StackPanel Classes="headerRow" DockPanel.Dock="Right">
							<TextBlock
								Classes="label"
								Text="LAP"
								IsVisible="{Binding SessionInfo.LapsString, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							<TextBlock
								Text="{Binding SessionInfo.LapsString}"
								IsVisible="{Binding SessionInfo.LapsString, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							<TextBlock Classes="label" Text="INC"/>
							<TextBlock Classes="incidents" Text="{Binding SessionInfo.IncidentCount}"/>
						</StackPanel>
						<StackPanel Classes="headerRow">
							<Border
								Classes="chip sessionChip"
								IsVisible="{Binding SessionInfo.SessionType, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
								<TextBlock Text="{Binding SessionInfo.SessionType}"/>
							</Border>
							<TextBlock
								Classes="timeLeft"
								Text="{Binding SessionInfo.TimeRemain, Converter={StaticResource SecToTimeConverter}, ConverterParameter=Session}"/>
							<TextBlock Classes="label" Text="SOF"/>
							<TextBlock Text="{Binding SessionInfo.SOF, StringFormat='{}{0:N0}'}"/>
						</StackPanel>
					</DockPanel>
				</Border>
				<!-- No bottom margin: the player's highlighted row may be the last one and must reach the panel edge. -->
				<table:RaceTable
					Margin="0,4,0,0"
					Columns="{Binding Columns}"
					ShowColumnTitles="{Binding ShowColumnTitles}"
					Rows="{Binding RaceDataList}"/>
			</StackPanel>
		</Border>
	</LayoutTransformControl>
</Window>
