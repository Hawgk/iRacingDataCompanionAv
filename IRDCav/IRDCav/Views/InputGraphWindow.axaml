<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IRDCav.ViewModels"
        xmlns:views="using:IRDCav.Views"
        x:Class="IRDCav.Views.InputGraphWindow"
        x:DataType="vm:InputGraphViewModel"
        Classes="overlay"
        Icon="/Assets/icon.ico"
        Title="iRDCav Input Graph"
        SizeToContent="WidthAndHeight"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        IsVisible="{Binding IsVisible}">
	<LayoutTransformControl HorizontalAlignment="Left" VerticalAlignment="Top">
		<Border Classes="panel" Padding="10">
			<views:InputTraceControl
				Width="280"
				Height="100"
				Samples="{Binding Samples}"
				Capacity="{Binding SampleCount}"
				ThrottleBrush="{DynamicResource Overlay.Throttle}"
				BrakeBrush="{DynamicResource Overlay.Brake}"
				TrackBrush="{DynamicResource Overlay.Track}"/>
		</Border>
	</LayoutTransformControl>
</Window>
