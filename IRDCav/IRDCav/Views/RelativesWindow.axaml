<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IRDCav.ViewModels"
        xmlns:table="using:IRDCav.Views.Table"
        x:Class="IRDCav.Views.RelativesWindow"
        x:DataType="vm:RelativesViewModel"
        Classes="overlay"
        Icon="/Assets/icon.ico"
        Title="iRDCav Relatives"
        SizeToContent="WidthAndHeight"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        IsVisible="{Binding IsVisible}">
	<LayoutTransformControl HorizontalAlignment="Left" VerticalAlignment="Top">
		<Border Classes="panel">
			<StackPanel>
				<table:RaceTable
					Margin="0,4"
					Columns="{Binding Columns}"
					ShowColumnTitles="{Binding ShowColumnTitles}"
					Rows="{Binding RaceDataList}"/>
			</StackPanel>
		</Border>
	</LayoutTransformControl>
</Window>
