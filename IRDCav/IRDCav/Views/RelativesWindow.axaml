<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IRDCav.ViewModels"
        xmlns:table="using:IRDCav.Views.Table"
        x:Class="IRDCav.Views.RelativesWindow"
        x:DataType="vm:RelativesViewModel"
        Classes="overlay"
        Icon="/Assets/icon.ico"
        Title="iRDCav Relatives"
        SizeToContent="WidthAndHeight"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        IsVisible="{Binding IsVisible}">
	<Window.Resources>
		<DataTemplate x:Key="FuelEstimateTemplate" x:DataType="vm:FuelEstimate">
			<StackPanel
				Classes="fuelEstimate"
				Classes.selected="{Binding IsSelected}"
				Classes.short="{Binding NeedsRefuel}">
				<TextBlock Classes="label" Text="{Binding Label}"/>
				<TextBlock Classes="fuelAmount" Text="{Binding Amount}"/>
			</StackPanel>
		</DataTemplate>
	</Window.Resources>
	<LayoutTransformControl HorizontalAlignment="Left" VerticalAlignment="Top">
		<Border Classes="panel">
			<StackPanel>
				<Border Classes="header">
					<DockPanel>
						<StackPanel Classes="headerRow" DockPanel.Dock="Right" ToolTip.Tip="Wind relative to your car">
							<Viewbox Classes="icon windArrow" RenderTransform="{Binding SessionInfo.WindAngle, Converter={StaticResource RotationConverter}}">
								<Path Data="{StaticResource Icon.WindArrow}"/>
							</Viewbox>
							<TextBlock Text="{Binding SessionInfo.WindSpeed, StringFormat='{}{0:0} km/h'}"/>
						</StackPanel>
						<StackPanel Classes="headerRow">
							<Viewbox Classes="icon"><Path Data="{StaticResource Icon.AirTemperature}"/></Viewbox>
							<TextBlock Classes="weatherValue" Text="{Binding SessionInfo.AirTemp}"/>
							<Viewbox Classes="icon"><Path Data="{StaticResource Icon.TrackTemperature}"/></Viewbox>
							<TextBlock Classes="weatherValue" Text="{Binding SessionInfo.SurfaceTemp}"/>
							<Viewbox Classes="icon"><Path Data="{StaticResource Icon.Humidity}"/></Viewbox>
							<TextBlock Classes="weatherValue" Text="{Binding SessionInfo.Humidity}"/>
							<Viewbox Classes="icon"><Path Data="{StaticResource Icon.Precipitation}"/></Viewbox>
							<TextBlock Text="{Binding SessionInfo.Precipitation}"/>
						</StackPanel>
					</DockPanel>
				</Border>
				<Border Classes="fuel">
					<StackPanel Spacing="2">
						<!-- All three estimates stay visible so the strategy can change mid-race; the configured one is enlarged. -->
						<StackPanel Classes="fuelEstimates">
							<TextBlock Classes="label" Text="REFUEL"/>
							<ContentControl Content="{Binding Fuel.Minimum}" ContentTemplate="{StaticResource FuelEstimateTemplate}"/>
							<ContentControl Content="{Binding Fuel.Average}" ContentTemplate="{StaticResource FuelEstimateTemplate}"/>
							<ContentControl Content="{Binding Fuel.Maximum}" ContentTemplate="{StaticResource FuelEstimateTemplate}"/>
						</StackPanel>
						<StackPanel Classes="fuelFacts" Orientation="Horizontal" Spacing="4">
							<TextBlock Classes="value" Text="{Binding Fuel.Tank}"/>
							<TextBlock Text="L in tank" Margin="0,0,10,0"/>
							<TextBlock Classes="value" Text="{Binding Fuel.PerLap}"/>
							<TextBlock Text="L/lap" Margin="0,0,10,0"/>
							<TextBlock Classes="value" Text="{Binding Fuel.Laps}"/>
							<TextBlock Text="laps"/>
						</StackPanel>
					</StackPanel>
				</Border>
				<table:RaceTable
					Margin="0,4"
					Columns="{Binding Columns}"
					ShowColumnTitles="{Binding ShowColumnTitles}"
					Rows="{Binding RaceDataList}"/>
			</StackPanel>
		</Border>
	</LayoutTransformControl>
</Window>
