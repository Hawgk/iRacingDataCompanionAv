<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IRDCav.App"
             xmlns:conv="using:IRDCav.Converters"
             xmlns:vm="using:IRDCav.ViewModels"
             x:DataType="vm:ApplicationViewModel"
             RequestedThemeVariant="Dark">
	<!--
	Colors are not defined here: OverlayTheme publishes them from config.json as
	"Overlay.*" brushes, so every color below is a DynamicResource.
	-->
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://IRDCav/Views/Table/RaceColumnTemplates.axaml"/>
			</ResourceDictionary.MergedDictionaries>

			<conv:SecToTimeConverter x:Key="SecToTimeConverter"/>
			<conv:DriverNameConverter x:Key="DriverNameConverter"/>
			<conv:PositiveNumberConverter x:Key="PositiveNumberConverter"/>
			<conv:SignedNumberConverter x:Key="SignedNumberConverter"/>
			<conv:SectorDeltaConverter x:Key="SectorDeltaConverter"/>
			<conv:TintConverter x:Key="TintConverter"/>
			<conv:RotationConverter x:Key="RotationConverter"/>

			<!-- Stroked icons on a 24 unit grid. -->
			<StreamGeometry x:Key="Icon.AirTemperature">M14 4v10.5a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0z</StreamGeometry>
			<StreamGeometry x:Key="Icon.TrackTemperature">M5 21L9 3M19 21L15 3M12 5v2M12 11v2M12 17v3</StreamGeometry>
			<StreamGeometry x:Key="Icon.Humidity">M12 3C12 3 18 9.5 18 14a6 6 0 0 1-12 0C6 9.5 12 3 12 3z</StreamGeometry>
			<StreamGeometry x:Key="Icon.Precipitation">M7 15a4 4 0 0 1-0.6-7.95A6 6 0 0 1 17.5 8.2A3.5 3.5 0 0 1 17 15M8 18v2M12 17v3M16 18v2</StreamGeometry>
			<StreamGeometry x:Key="Icon.WindArrow">M12 20V4M6 10l6-6l6 6</StreamGeometry>
		</ResourceDictionary>
	</Application.Resources>

	<Application.Styles>
		<FluentTheme/>

		<!-- Overlay windows and panels -->
		<Style Selector="Window.overlay">
			<Setter Property="FontFamily" Value="{DynamicResource Overlay.FontFamily}"/>
			<Setter Property="FontSize" Value="{DynamicResource Overlay.FontSize.Normal}"/>
			<Setter Property="Foreground" Value="{DynamicResource Overlay.Text}"/>
		</Style>
		<Style Selector="Border.panel">
			<Setter Property="Background" Value="{DynamicResource Overlay.Background}"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="ClipToBounds" Value="True"/>
		</Style>
		<Style Selector="Border.header">
			<Setter Property="Background" Value="{DynamicResource Overlay.Surface}"/>
			<Setter Property="Padding" Value="10,7"/>
		</Style>
		<!-- Every text is shifted by its font size's share of the font's capital offset, see CapitalCentering. -->
		<Style Selector="Window.overlay TextBlock">
			<Setter Property="RenderTransform" Value="{DynamicResource Overlay.TextShift.Normal}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="TextBlock.label">
			<Setter Property="RenderTransform" Value="{DynamicResource Overlay.TextShift.Small}"/>
			<Setter Property="FontSize" Value="{DynamicResource Overlay.FontSize.Small}"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="LetterSpacing" Value="0.9"/>
			<Setter Property="Foreground" Value="{DynamicResource Overlay.TextMuted}"/>
		</Style>
		<Style Selector="TextBlock.timeLeft">
			<Setter Property="RenderTransform" Value="{DynamicResource Overlay.TextShift.Large}"/>
			<Setter Property="FontSize" Value="{DynamicResource Overlay.FontSize.Large}"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
		<Style Selector="TextBlock.incidents">
			<Setter Property="Foreground" Value="{DynamicResource Overlay.Warning}"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
		<!--
		Texts of different sizes in one row share a line height, so each is centered on the
		same line instead of in boxes of different heights that round to different pixels.
		-->
		<Style Selector="StackPanel.headerRow">
			<Setter Property="Orientation" Value="Horizontal"/>
			<Setter Property="Spacing" Value="5"/>
		</Style>
		<Style Selector="StackPanel.headerRow > TextBlock">
			<Setter Property="LineHeight" Value="{DynamicResource Overlay.MixedLineHeight}"/>
		</Style>
		<Style Selector="StackPanel.headerRow > TextBlock.label, StackPanel.headerRow > TextBlock.timeLeft">
			<Setter Property="Margin" Value="7,0,0,0"/>
		</Style>
		<Style Selector="StackPanel.headerRow > TextBlock.weatherValue">
			<Setter Property="Margin" Value="0,0,7,0"/>
		</Style>
		<!-- Icons keep their 24 unit grid instead of being stretched to their outline, so their optical centers line up. -->
		<Style Selector="Viewbox.icon">
			<Setter Property="Width" Value="{DynamicResource Overlay.IconSize}"/>
			<Setter Property="Height" Value="{DynamicResource Overlay.IconSize}"/>
		</Style>
		<Style Selector="Viewbox.icon > Path">
			<Setter Property="Width" Value="24"/>
			<Setter Property="Height" Value="24"/>
			<Setter Property="Stroke" Value="{DynamicResource Overlay.TextMuted}"/>
			<Setter Property="StrokeThickness" Value="2"/>
			<Setter Property="StrokeLineCap" Value="Round"/>
			<Setter Property="StrokeJoin" Value="Round"/>
		</Style>
		<Style Selector="Viewbox.windArrow > Path">
			<Setter Property="Stroke" Value="{DynamicResource Overlay.Text}"/>
		</Style>

		<!-- Fuel -->
		<Style Selector="Border.fuel">
			<Setter Property="Padding" Value="11,8,11,9"/>
		</Style>
		<!-- Fuel table: values right-aligned in their columns, captions left-aligned in theirs. Each row shares one line height to stay centered. -->
		<Style Selector="TextBlock.fuelRowLabel">
			<Setter Property="Margin" Value="0,0,12,0"/>
		</Style>
		<Style Selector="StackPanel.fuelCell">
			<Setter Property="Orientation" Value="Horizontal"/>
			<Setter Property="Spacing" Value="4"/>
		</Style>
		<Style Selector="TextBlock.estimateRow">
			<Setter Property="LineHeight" Value="{DynamicResource Overlay.MixedLineHeight}"/>
		</Style>
		<Style Selector="TextBlock.factRow">
			<Setter Property="LineHeight" Value="{DynamicResource Overlay.FactLineHeight}"/>
		</Style>
		<Style Selector="TextBlock.fuelValue">
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="HorizontalAlignment" Value="Right"/>
		</Style>
		<Style Selector="TextBlock.fuelCaption">
			<Setter Property="Margin" Value="4,0,16,0"/>
		</Style>
		<Style Selector="TextBlock.fuelValue.selected">
			<Setter Property="RenderTransform" Value="{DynamicResource Overlay.TextShift.Large}"/>
			<Setter Property="FontSize" Value="{DynamicResource Overlay.FontSize.Large}"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="{DynamicResource Overlay.PitRoad}"/>
		</Style>
		<Style Selector="TextBlock.fuelValue.selected.short">
			<Setter Property="Foreground" Value="{DynamicResource Overlay.LapAhead}"/>
		</Style>

		<!-- Sectors: every row has the same fixed-width columns and one line height for its small and normal texts. -->
		<Style Selector="Border.sectorHeader">
			<Setter Property="Padding" Value="10,2"/>
		</Style>
		<Style Selector="ItemsControl.sectors">
			<Setter Property="Margin" Value="10,2,10,4"/>
		</Style>
		<Style Selector="StackPanel.sectorRow">
			<Setter Property="Orientation" Value="Horizontal"/>
			<Setter Property="Height" Value="{DynamicResource Overlay.RowHeight}"/>
		</Style>
		<Style Selector="StackPanel.sectorRow > TextBlock">
			<Setter Property="LineHeight" Value="{DynamicResource Overlay.RowHeight}"/>
			<Setter Property="TextAlignment" Value="Right"/>
		</Style>
		<Style Selector="StackPanel.sectorRow > TextBlock.sectorLabel">
			<Setter Property="Width" Value="{DynamicResource Overlay.SectorLabelWidth}"/>
			<Setter Property="TextAlignment" Value="Left"/>
		</Style>
		<Style Selector="TextBlock.sectorTime">
			<Setter Property="Width" Value="{DynamicResource Overlay.SectorTimeWidth}"/>
		</Style>
		<Style Selector="TextBlock.bestLapTime">
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
		<Style Selector="TextBlock.sectorDelta">
			<Setter Property="Width" Value="{DynamicResource Overlay.SectorDeltaWidth}"/>
		</Style>
		<Style Selector="TextBlock.sectorDelta.gain">
			<Setter Property="Foreground" Value="{DynamicResource Overlay.TimeGain}"/>
		</Style>
		<Style Selector="TextBlock.sectorDelta.loss">
			<Setter Property="Foreground" Value="{DynamicResource Overlay.TimeLoss}"/>
		</Style>

		<!-- Race tables. Row states first, so the cell styles after them win. -->
		<Style Selector="Panel.raceRow">
			<Setter Property="Height" Value="{DynamicResource Overlay.RowHeight}"/>
		</Style>
		<Style Selector="Border.carRow">
			<Setter Property="Padding" Value="6,0"/>
		</Style>
		<Style Selector="StackPanel.columnTitles">
			<Setter Property="Margin" Value="6,0"/>
			<Setter Property="Height" Value="{DynamicResource Overlay.TitleRowHeight}"/>
		</Style>
		<Style Selector="TextBlock.columnTitle">
			<Setter Property="RenderTransform" Value="{DynamicResource Overlay.TextShift.Small}"/>
			<Setter Property="FontSize" Value="{DynamicResource Overlay.FontSize.Small}"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="LetterSpacing" Value="1"/>
			<Setter Property="Foreground" Value="{DynamicResource Overlay.TextMuted}"/>
		</Style>
		<Style Selector="Border.cell">
			<Setter Property="Padding" Value="5,0"/>
			<Setter Property="ClipToBounds" Value="True"/>
		</Style>
		<Style Selector="TextBlock.classHeader">
			<Setter Property="RenderTransform" Value="{DynamicResource Overlay.TextShift.Small}"/>
			<Setter Property="Margin" Value="11,0"/>
			<Setter Property="FontSize" Value="{DynamicResource Overlay.FontSize.Small}"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="LetterSpacing" Value="0.8"/>
			<Setter Property="VerticalAlignment" Value="Bottom"/>
			<Setter Property="Padding" Value="0,0,0,4"/>
		</Style>
		<Style Selector="Border.carRow.me">
			<Setter Property="Background" Value="{DynamicResource Overlay.PlayerRow}"/>
		</Style>
		<Style Selector="Border.carRow.lapAhead TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Overlay.LapAhead}"/>
		</Style>
		<Style Selector="Border.carRow.lapBehind TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Overlay.LapBehind}"/>
		</Style>
		<Style Selector="Border.carRow.pit TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Overlay.TextMuted}"/>
		</Style>
		<Style Selector="Border.carRow.me TextBlock.driver">
			<Setter Property="Foreground" Value="{DynamicResource Overlay.PlayerHighlight}"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
		<Style Selector="TextBlock.driver">
			<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
		</Style>
		<Style Selector="TextBlock.carNumber">
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
		<Style Selector="TextBlock.carClass">
			<Setter Property="RenderTransform" Value="{DynamicResource Overlay.TextShift.Small}"/>
			<Setter Property="FontSize" Value="{DynamicResource Overlay.FontSize.Small}"/>
			<Setter Property="FontWeight" Value="Bold"/>
		</Style>
		<Style Selector="Border.classStripe">
			<Setter Property="Width" Value="3"/>
			<Setter Property="Height" Value="{DynamicResource Overlay.StripeHeight}"/>
			<Setter Property="CornerRadius" Value="1"/>
		</Style>
		<Style Selector="TextBlock.fastest">
			<Setter Property="Foreground" Value="{DynamicResource Overlay.FastestLap}"/>
		</Style>

		<Style Selector="TextBlock.iRatingChange">
			<Setter Property="Foreground" Value="{DynamicResource Overlay.TextMuted}"/>
		</Style>
		<Style Selector="TextBlock.iRatingChange.gain">
			<Setter Property="Foreground" Value="{DynamicResource Overlay.IRatingGain}"/>
		</Style>
		<Style Selector="TextBlock.iRatingChange.loss">
			<Setter Property="Foreground" Value="{DynamicResource Overlay.IRatingLoss}"/>
		</Style>

		<!-- Chips -->
		<!-- All badges share one height; their widths are fixed per kind, so content never changes their size. -->
		<Style Selector="Border.chip">
			<Setter Property="CornerRadius" Value="3"/>
			<Setter Property="Padding" Value="5,0"/>
			<Setter Property="Height" Value="{DynamicResource Overlay.BadgeHeight}"/>
		</Style>
		<Style Selector="Border.chip TextBlock">
			<Setter Property="RenderTransform" Value="{DynamicResource Overlay.TextShift.Small}"/>
			<Setter Property="FontSize" Value="{DynamicResource Overlay.FontSize.Small}"/>
			<Setter Property="FontWeight" Value="Bold"/>
		</Style>
		<Style Selector="Border.pitChip">
			<Setter Property="Background" Value="{DynamicResource Overlay.PitRoadChip}"/>
		</Style>
		<Style Selector="Border.pitChip > TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Overlay.PitRoad}"/>
			<Setter Property="LetterSpacing" Value="0.6"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Border.tireChip > TextBlock">
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Border.sessionChip">
			<Setter Property="Background" Value="{DynamicResource Overlay.Text}"/>
			<Setter Property="Width" Value="{DynamicResource Overlay.LetterBadgeWidth}"/>
		</Style>
		<Style Selector="Border.sessionChip > TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Overlay.OnText}"/>
			<Setter Property="FontSize" Value="{DynamicResource Overlay.FontSize.Small}"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>
	</Application.Styles>

	<TrayIcon.Icons>
		<TrayIcons>
			<TrayIcon Icon="/Assets/icon.ico" ToolTipText="iRDCav Overlay">
				<TrayIcon.Menu>
					<NativeMenu>
						<NativeMenuItem Header="Settings (F7)" Command="{Binding OpenSettingsCommand}" />
						<NativeMenuItem Header="Exit" Command="{Binding ExitCommand}" />
					</NativeMenu>
				</TrayIcon.Menu>
			</TrayIcon>
		</TrayIcons>
	</TrayIcon.Icons>
</Application>
